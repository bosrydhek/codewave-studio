# Supabase Configuration
# Create a .env.local file with your development project credentials
# The variables below should point to your "Dev" project on the Supabase free tier.

NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-project-anon-key

# Production variables (for Vercel/Deployment environment)
# VITE_SUPABASE_PROJECT_URL=https://your-prod-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-prod-project-anon-key
